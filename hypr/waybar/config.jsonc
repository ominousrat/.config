{
  "layer": "top",
  "position": "top",
  "output": "DP-3",
  "height": 36,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "margin-bottom": -6,
  "spacing": 4,

  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "tray", "cpu", "memory", "battery"],

  "custom/launcher": {
    "format": "⚡︎",
    "on-click": "rofi -show combi",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": true,
    "active-only": false,
    "move-to-monitor": false,
    "persistent-workspaces": {
      "*": [1, 2, 3]
    }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "clock": {
    "format": "  {:%H:%M}  "
  },

  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": "⛃ {}%"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },

  "tray": {
  "icon-size": 16,
  "spacing": 6,
  "show-passive-items": true
}
}
